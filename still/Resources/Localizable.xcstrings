      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "Still": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Still"
          }
        }
      }
    },
    "Take a quiet pause": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かな休息をとる"
          }
        }
      }
    },
    "Terms of Use": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用規約"
          }
        }
      }
    },
    "The App Store is unavailable. Try again later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeを利用できません。時間をおいてもう一度お試しください。"
          }
        }
      }
    },
    "The App Store transaction could not be verified.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeの取引を検証できませんでした。"
          }
        }
      }
    },
    "The on-device assistant is unavailable on this device or for the current language. Paid plans can’t be purchased until it becomes available.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスまたは現在の言語ではオンデバイスアシスタントを利用できません。利用可能になるまで有料プランは購入できません。"
          }
        }
      }
    },
    "The on-device assistant is unavailable.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスアシスタントを利用できません。"
          }
        }
      }
    },
    "The on-device model couldn’t complete this request.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモデルがこのリクエストを完了できませんでした。"
          }
        }
      }
    },
    "The on-device model doesn’t support a language in this request.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモデルは、このリクエストで使用されている言語に対応していません。"
          }
        }
      }
    },
    "The on-device model is busy. Please try again shortly.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモデルは処理中です。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "This product is unavailable. Try again later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この製品を利用できません。時間をおいてもう一度お試しください。"
          }
        }
      }
    },
    "The purchase is waiting for approval.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。"
          }
        }
      }
    },
    "The request is too long. Shorten it and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが長すぎます。短くしてからもう一度お試しください。"
          }
        }
      }
    },
    "The request or response was blocked for safety.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全上の理由により、リクエストまたは応答がブロックされました。"
          }
        }
      }
    },
    "This completed pause will be permanently deleted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了した休息を完全に削除します。"
          }
        }
      }
    },
    "Unavailable": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用不可"
          }
        }
      }
    },
    "View Pro options": {
      "comment": "A button that opens the Pro options screen.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proのオプションを表示"
