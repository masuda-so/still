          }
        }
      }
    },
    "Restore Purchases": {
      "comment": "A button that restores purchases.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元"
          }
        }
      }
    },
    "Settings": {
