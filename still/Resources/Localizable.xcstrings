{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@ remains usable without the assistant.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@はアシスタントなしでも利用できます。"
          }
        }
      }
    },
    "Apple Intelligence is turned off.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceがオフになっています。"
          }
        }
      }
    },
    "Auto-renews until cancelled.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約するまで自動更新されます。"
          }
        }
      }
    },
    "One-time access for %lld hours. Does not auto-renew.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld時間の買い切りアクセスです。自動更新されません。"
          }
        }
      }
    },
    "Processed on this device with Apple Foundation Models.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Modelsを使用して、このデバイス上で処理されます。"
          }
        }
      }
    },
    "The on-device model doesn’t support the current language.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモデルは現在の言語に対応していません。"
          }
        }
      }
    },
    "The on-device model is unavailable.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモデルは利用できません。"
          }
        }
      }
    },
    "The on-device model isn’t ready yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモデルの準備がまだ完了していません。"
          }
        }
      }
    },
    "This device doesn’t support the on-device model.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはオンデバイスモデルに対応していません。"
          }
        }
      }
    },
    "This operating system version doesn’t support the on-device model.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このOSバージョンはオンデバイスモデルに対応していません。"
          }
        }
      }
    },
    "%@ Pro": {
      "comment": "A title that describes the product and its benefits.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Pro"
          }
        }
      }
    },
    "%@ Pro is active": {
      "comment": "A title that describes the product and its benefits.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Proが有効です"
          }
        }
      }
    },
    "%@ Pro is active.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Proが有効です。"
          }
        }
      }
    },
    "%@ Pro was restored.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Proを復元しました。"
          }
        }
      }
    },
    "%@ is a Pro feature": {
      "comment": "A title for a locked view that lets the user learn more about the Pro option.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はPro機能です"
          }
        }
      }
    },
    "%lld min": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld分"
          }
        }
      }
    },
    "%lld minute pause": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld分間の休息"
          }
        }
      }
    },
    "A quiet pause, exactly when you need it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な時に、静かなひと休みを。"
          }
        }
      }
    },
    "The on-device model couldn’t generate a response. Try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモデルで応答を生成できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "AI generation was cancelled.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIによる生成をキャンセルしました。"
          }
        }
      }
    },
    "AI requests use the on-device model when available.": {
      "comment": "A description of how the app uses the on-device AI model for requests.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIリクエストには、利用可能な場合はオンデバイスモデルを使用します。"
          }
        }
      }
    },
    "Active until %@": {
      "comment": "A label displaying the expiration date of a daily pass. The argument is the expiration date.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@まで有効"
          }
        }
      }
    },
    "Another request is still running. Please wait a moment.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のリクエストを処理中です。しばらくお待ちください。"
          }
        }
      }
    },
    "App": {
      "comment": "The name of the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ"
          }
        }
      }
    },
    "Assistant": {
      "comment": "A tab for the assistant features.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタント"
          }
        }
      }
    },
    "Availability": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用状況"
          }
        }
      }
    },
    "Available": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能"
          }
        }
      }
    },
    "Begin Pause": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休息を始める"
          }
        }
      }
    },
    "Breathe naturally": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自然に呼吸しましょう"
          }
        }
      }
    },
    "Bundle ID": {
      "comment": "The label for the bundle identifier of the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle ID"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Choose a Pro plan to use the on-device assistant.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスアシスタントを使用するには、Proプランを選択してください。"
          }
        }
      }
    },
    "Choose the non-renewing Daily Pass or an auto-renewing plan to use the on-device assistant.": {
      "comment": "A description of the Pro options available to the user.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスアシスタントを使用するには、自動更新されないDaily Passまたは自動更新プランを選択してください。"
          }
        }
      }
    },
    "Completed pauses will appear here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了した休息がここに表示されます。"
          }
        }
      }
    },
    "Data Error": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データエラー"
          }
        }
      }
    },
    "Delete Pause": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休息を削除"
          }
        }
      }
    },
    "End Pause": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休息を終了"
          }
        }
      }
    },
    "Enter a prompt before generating a response.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答を生成する前にプロンプトを入力してください。"
          }
        }
      }
    },
    "How does this moment feel?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この瞬間をどう感じましたか？"
          }
        }
      }
    },
    "Legal": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "法的情報"
          }
        }
      }
    },
    "Manage Subscription": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションを管理"
          }
        }
      }
    },
    "No Pauses Yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休息の記録はまだありません"
          }
        }
      }
    },
    "No StoreKit products are available yet. Add the %@ products in App Store Connect or a local StoreKit configuration before purchase testing.": {
      "comment": "A card that appears when the user has no StoreKit products to choose from.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StoreKit製品をまだ利用できません。購入テストの前に、App Store ConnectまたはローカルStoreKit構成へ%@の製品を追加してください。"
          }
        }
      }
    },
    "No active %@ Pro purchase was found.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な%@ Proの購入は見つかりませんでした。"
          }
        }
      }
    },
    "No analytics or remote AI service is included in this foundation.": {
      "comment": "A description of the privacy policy of the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この基盤には、分析機能やリモートAIサービスは含まれていません。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
